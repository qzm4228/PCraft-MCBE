{
   "format_version":"1.10.0",
   "animation_controllers":{
		 "controller.animation.sneaking": {
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
						{
							"a" : "query.is_sneaking && !variable.is_first_person && !query.is_swimming && !query.is_gliding"
						}
					]
				},
				"a": {
					"animations": [
						"sneak"
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"b": "!query.is_sneaking || variable.is_first_person"
						}
					]
				},
				"b": {
					"animations": [
						"unsneak"
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"default" : "query.is_sneaking || variable.is_first_person"
						}
					]
				}
			}
		},
       "controller.animation.player.hide":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_spectator && !variable.is_first_person"
                  }
               ],
               "blend_transition":0.0
            },
            "a":{
               "animations":[
                  "hide"
               ],
               "transitions":[
                  {
                     "default":"!query.is_spectator"
                  }
               ],
               "blend_transition":0.0
            }
         }
      },
  "controller.animation.player.turnr": {
    "states": {
      "default": {
        "transitions": [
          { "turn": "math.abs(query.target_y_rotation) > 10.0 && query.is_alive" }
        ],
        "blend_transition": 0.08
      },

      "turn": {
        "animations": [
          "turnr"
        ],
        "transitions": [
          { "default": "math.abs(query.target_y_rotation) < 10.0 && query.all_animations_finished" }
        ],
        "blend_transition": 1.0
      }
    }
  },
    "controller.animation.player.attacking":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"variable.fighting && !variable.is_first_person && query.is_alive"
                  }
               ],
               "blend_transition":0.1
            },
            "a":{
               "animations":[
                  "attack"
               ],
               "transitions":[
                  {
                     "default":"!variable.fighting"
                  }
               ],
               "blend_transition":0.1
            }
         }
      },
      "controller.animation.player.punching":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"variable.fighting && !variable.is_first_person && !variable.bf && !variable.fishing"
                  }
               ],
               "blend_transition":0.1
            },
            "a":{
               "animations":[
                  "punching"
               ],
               "transitions":[
                  {
                     "default":"!variable.fighting"
                  }
               ],
               "blend_transition":0.1
            }
         }
      },
      "controller.animation.player.stop":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"!query.is_moving && !variable.is_first_person && query.is_alive"
                  }
               ],
               "blend_transition":0.1
            },
            "a":{
               "animations":[
                  "stopping"
               ],
               "transitions":[
                  {
                     "default":"query.is_moving"
                  }
               ],
               "blend_transition":0.1
            }
         }
      },
  "controller.animation.player.walk": {
    "states": {
      "default": {
        "variables": {
          "move_speed": {
            "input": "query.modified_move_speed",
            "remap_curve": {
              "0.0": 0.0,
              "0.25": 1.0
            }
          }
        },
        "animations": [
          {
            "walk": "variable.move_speed"
            }
          ]
        }
      }
    },
      "controller.animation.player.fall":{
"states": {
    "default": {
        "transitions": [
      {
        "falling": "query.vertical_speed < -0.15 && !query.is_on_ground && !query.is_gliding && !query.is_in_water && !variable.is_first_person && !variable.RJ"
      }
    ],
    "blend_transition": 3.0
  },
  "falling": {
    "animations": ["fall"],
    "transitions": [
      {
        "landing": "query.is_on_ground || variable.RJ"
      }
    ],
    "blend_transition": 0.3
  },
  "landing": {
    "animations": ["stopping"],
    "transitions": [
      {
        "default": "true"
      }
    ],
    "blend_transition": 1.0
         }
      }
   },
      "controller.animation.player.jump":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.vertical_speed > 0.1 && !query.is_on_ground && !variable.is_first_person && !query.is_in_water"
                  }
               ],
               "blend_transition":0.1
            },
            "a":{
               "animations":[
                  "jump"
               ],
               "transitions":[
                  {
                     "default":"query.is_on_ground"
                  }
               ],
               "blend_transition":1.2
            }
         }
      }
   }
}