{
   "format_version":"1.10.0",
   "animation_controllers":{
            "controller.animation.player.fishing_rod_use":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"variable.fishing_rod && !variable.is_first_person && !variable.RJ && !query.is_swimming && !query.is_crawling && !query.is_gliding && variable.fighting"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
                  "fishing_rod_use"
               ],
               "transitions":[
                  {
                     "default":"!variable.fishing_rod || variable.is_first_person || variable.RJ || query.is_crawling || query.is_gliding || query.is_swimming || !variable.fighting"
                  }
               ],
               "blend_transition":0.2
            }
         }
      },
       "controller.animation.player.fishing_rod":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"variable.fishing_rod && !variable.is_first_person && !variable.RJ && !query.is_swimming && !query.is_crawling && !query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
                  "fishing_rod_hold"
               ],
               "transitions":[
                  {
                     "default":"!variable.fishing_rod || variable.is_first_person || variable.RJ || query.is_crawling || query.is_gliding || query.is_swimming"
                  }
               ],
               "blend_transition":0.2
            }
         }
      },
      "controller.animation.player.walking":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_moving && !query.is_sprinting && !variable.is_first_person && !query.item_is_charged && !variable.bow && !variable.fishing_rod && !query.is_gliding"
                  },
                  {
                     "b":"query.is_moving && !query.is_sprinting && !variable.is_first_person && variable.bf && !query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
               {
                  "walking": "query.modified_move_speed"
                  }
               ],
               "transitions":[
                  {
                     "default":"!query.is_moving || query.is_sprinting || variable.is_first_person || query.item_is_charged || variable.bow || variable.fishing_rod || query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            },
            "b":{
               "animations":[
               {
                  "walking_legs": "query.modified_move_speed"
                  }
               ],
               "transitions":[
                  {
                     "default":"!query.is_moving || query.is_sprinting || variable.is_first_person || !variable.bf || query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            }
         }
      },
      "controller.animation.player.walking_legs":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_moving && !query.is_sprinting && !variable.is_first_person && query.item_is_charged && !query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
               {
                  "walking_legs": "query.modified_move_speed"
                  }
               ],
               "transitions":[
                  {
                     "default":"!query.is_moving || query.is_sprinting || variable.is_first_person || !query.item_is_charged || query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            }
         }
      },
      "controller.animation.player.running":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_moving && query.is_sprinting && !variable.is_first_person && !variable.RJ && !query.is_in_water && !query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !query.is_gliding"
                  },
                  {
                     "b":"query.is_moving && query.is_sprinting && !variable.is_first_person && !variable.RJ && !query.is_in_water && query.item_is_charged && !query.is_gliding"
                  },
                  {
                     "c":"query.is_moving && query.is_sprinting && !variable.is_first_person && !variable.RJ && !query.is_in_water && query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !query.is_gliding"
                  },
                  {
                     "d":"query.is_moving && query.is_sprinting && !variable.is_first_person && !variable.RJ && !query.is_in_water && variable.fishing_rod && !query.is_gliding"   
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
                  "running"
               ],
               "transitions":[
                  {
                     "default":"!query.is_sprinting || !query.is_moving || variable.is_first_person || variable.RJ || query.is_gliding"
                  },
                  {
                  "b":"query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !variable.fishing_rod"
                  },
                  {
                  "c":"query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !query.item_is_charged && !variable.fishing_rod"
                  },
                  {
                  "d":"variable.fishing_rod && !query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  }
               ],
               "blend_transition":0.2
            },
            "b":{
               "animations":[
                  "running_legs"
               ],
               "transitions":[
                  {
                     "default":"!query.is_sprinting || !query.is_moving || variable.is_first_person || variable.RJ || query.is_gliding"
                  },
                  {
                  "a":"!query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !variable.fishing_rod"
                  },
                  {
                  "c":"!query.item_is_charged && query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !variable.fishing_rod"
                  },
                  {
                  "d":"variable.fishing_rod && !query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  }
               ],
               "blend_transition":0.2
            },
            "c":{
               "animations":[
                  "running_spear"
               ],
               "transitions":[
                  {
                     "default":"!query.is_sprinting || !query.is_moving || variable.is_first_person || variable.RJ || query.is_gliding"
                  },
                  {
                  "a":"!query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !query.item_is_charged && !variable.fishing_rod"
                  },
                  {
                  "b":"!query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && query.item_is_charged && !variable.fishing_rod"
                  },
                  {
                  "d":"variable.fishing_rod && !query.item_is_charged && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  }
               ],
               "blend_transition":0.2
               },
               "d":{
               "animations":[
                  "running_legs"
               ],
               "transitions":[
                  {
                     "default":"!query.is_sprinting || !query.is_moving || variable.is_first_person || variable.RJ || query.is_gliding"
                  },
                  {
                  "a":"!query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !query.item_is_charged && !variable.fishing_rod"
                  },
                  {
                  "b":"!query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && query.item_is_charged && !variable.fishing_rod"
                  },
                  {
                  "c":"!query.item_is_charged && query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear') && !variable.fishing_rod"
                  }
               ],
               "blend_transition":0.2
               }
           }
       },
      "controller.animation.player.bow_charging":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"variable.bow && !variable.is_first_person"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
                  "bow_charging"
               ],
               "transitions":[
                  {
                     "default":"!variable.bow || variable.is_first_person"
                  }
               ],
               "blend_transition":0.4
            }
         }
      },
      "controller.animation.player.jumping":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "jump":"!query.is_on_ground"
                  }
               ],
               "blend_transition":0.1
            },
            "jump":{
               "animations":[
                  "jump"
               ],
               "transitions":[
                  {
                     "default":"query.is_on_ground"
                  }
               ],
               "blend_transition":1.2
            }
         }
      },
      "controller.animation.player.gliding":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            },
            "a":{
               "animations":[
                  "gliding"
               ],
               "transitions":[
                  {
                     "default":"!query.is_gliding"
                  }
               ],
               "blend_transition":0.2
            }
         }
      },
      "controller.animation.player.swimming":{
         "states":{
            "default":{
               "transitions":[
                  {
                     "a":"query.is_in_water && query.is_swimming && !variable.is_first_person && !query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  },
                  {
                     "b":"query.is_in_water && query.is_swimming && !variable.is_first_person && query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  }
               ],
               "blend_transition":0.7
            },
            "a":{
               "animations":[
                  "swim"
               ],
               "transitions":[
                  {
                     "b":"query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  },
                  {
                     "default":"!query.is_in_water || !query.is_swimming || variable.is_first_person"
                  }
               ],
               "blend_transition":0.7
         },
         "b":{
               "animations":[
                  "swim_spear"
               ],
               "transitions":[
                  {
                     "a":"!query.equipped_item_any_tag('slot.weapon.mainhand', 'minecraft:is_spear')"
                  },
                  {
                     "default":"!query.is_in_water || !query.is_swimming || variable.is_first_person"
                     }
               ],
               "blend_transition":0.7
            }
         }
      },
      "controller.animation.RJ": {
			"states": {
				"default": {
					"blend_transition": 0.4,
					"transitions": [
						{
							"RA" : "!query.item_is_charged &&variable.RJ"
						}
					]
				},
				"RA": {
					"animations": [
						"rjra"
					],
					"blend_transition": 0.23,
					"transitions": [
						{
							"N": "query.item_is_charged || !variable.RJ"
						}
					]
				},
				"N": {
					"animations": [
						"no"
					],
					"blend_transition": 0.4,
					"transitions": [
						{
							"LA": "!query.item_is_charged &&variable.RJ"
						}
					]
				},
				"LA": {
					"animations": [
						"rjla"
					],
					"blend_transition": 0.23,
					"transitions": [
						{
							"default": "query.item_is_charged || !variable.RJ"
						}
					]
				}
			}
		}
	}
}