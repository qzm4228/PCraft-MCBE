{
  "namespace": "crafting",

  "recipe_inventory_screen_content": {
    "modifications": [
      {
        "operation": "insert_after",
        "control_name": "content_stack_panel",
        "value": [
          { "vcraft_entry@crafting.vcraft_entry_button": {} }
        ]
      }
    ]
  },

  // Trigger: button.form_button_click (no fake chat-box / send hack).
  "vcraft_entry_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "$text|default": "§d菜单",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -8, 8 ],
    "size": [ 44, 20 ],
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [ 0.14, 0.14, 0.18, 0.95 ],
          "controls": [
            { "label": { "type": "label", "text": "$text", "anchor_from": "center", "anchor_to": "center", "color": [ 1, 1, 1 ], "layer": 4, "font_scale_factor": 0.85 } }
          ]
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [ 0.3, 0.34, 0.44, 1 ],
          "controls": [
            { "label": { "type": "label", "text": "$text", "anchor_from": "center", "anchor_to": "center", "color": [ 1, 1, 1 ], "layer": 4, "font_scale_factor": 0.85 } }
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [ 0.08, 0.08, 0.1, 1 ],
          "offset": [ 0, 1 ],
          "controls": [
            { "label": { "type": "label", "text": "$text", "anchor_from": "center", "anchor_to": "center", "color": [ 1, 1, 1 ], "layer": 4, "font_scale_factor": 0.85 } }
          ]
        }
      }
    ]
  }
}
