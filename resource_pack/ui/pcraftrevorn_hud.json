{
  "namespace": "hud",

  // PCraftRevorn vore HUD (JSON-UI), modelled on VCM's VoreMinigameOverlay:
  // one 48x48 arrow in the middle (up red / right cyan / down magenta / left
  // green) plus the escape percentage in the bottom-right corner.
  //
  // Data flows through #hud_title_text_string, the only HUD text Bedrock exposes
  // globally, but it is never shown: the wiki's "conditionally hide a title"
  // pattern adds a #visible binding to hud_title_text/title_frame/title, so only
  // titles carrying our keyword are suppressed (every other title still works).
  //
  // Bus string: "pcr|" + 4 x "§2§r§<hex>§r" + "§7挣脱 §fNN%[ · Ns]"
  "hud_content": {
    "modifications": [
      {
        "operation": "insert_after",
        "control_name": "root_panel",
        "value": [
          { "pcr_struggle_arrow@hud.pcr_struggle_arrow": {} },
          { "pcr_struggle_pct@hud.pcr_struggle_pct": {} }
        ]
      }
    ]
  },

  // hide only OUR title text (path override + one extra binding, nothing is
  // redefined -- see wiki.bedrock.dev/json-ui/json-ui-intro#conditional-rendering)
  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "((#text - 'pcr|') = #text)",
          "target_property_name": "#visible"
        }
      }
    ]
  },

  // ---- the arrow (screen centre, like the mod) ----------------------------
  "pcr_struggle_arrow": {
    "type": "panel",
    "size": [ 48, 48 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 40,
    "controls": [
        {
          "arrow_up": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_up",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_type": "global", "binding_name": "#hud_title_text_string",
                "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§1§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_right": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_right",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_type": "global", "binding_name": "#hud_title_text_string",
                "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§d§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_down": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_down",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_type": "global", "binding_name": "#hud_title_text_string",
                "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§5§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_left": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_left",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_type": "global", "binding_name": "#hud_title_text_string",
                "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§9§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        }
    ]
  },

  // ---- escape percentage (bottom-right) ----------------------------------
  "pcr_struggle_pct": {
    "type": "panel",
    "size": [ 140, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -8 ],
    "layer": 40,
    "property_bag": { "#pcr_bus": "" },
    "bindings": [
      { "binding_type": "global", "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_bus - 'pcr|') = #pcr_bus))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "pcr_pct_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_pct_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "text": "(#pcr_bus - 'pcr|')",
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2
        }
      }
    ]
  }
}
