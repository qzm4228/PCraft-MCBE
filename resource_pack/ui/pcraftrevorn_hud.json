{
  "namespace": "hud",

  // PCraftRevorn vore HUD (JSON-UI).
  //
  // Patched exactly like the VCraft pack's ui/hud_screen.json: one
  // `insert_after root_panel` inside `hud_content`. Vanilla controls are never
  // redefined (doing that broke the whole HUD once).
  //
  // Data bus: the script writes one string into the *title*
  // (the only HUD text Bedrock exposes globally, `#hud_title_text_string`):
  //   "§0§r§2§r"                      gate marker (hides the centre title, shows the HUD)
  //   + 4 x "§2§r§<hex>§r"            per-direction state (dir*4 + state, see constants.js)
  //   + "§7挣脱 §fNN%"                escape percentage
  // Every element below binds that string and tests for its own marker.
  "hud_content": {
    "modifications": [
      {
        "operation": "insert_after",
        "control_name": "root_panel",
        "value": [
          { "pcr_struggle_pct@hud.pcr_struggle_pct": {} },
          { "pcr_arrows@hud.pcr_arrows": {} }
        ]
      }
    ]
  },

  // the bus is written into the title; drop its visible frame so nothing big is
  // printed in the middle (a modification, never a redefinition)
  "hud_title_text": {
    "modifications": [
      { "operation": "remove", "control_name": "title_frame" }
    ]
  },

  // ---- escape percentage (bottom-right) -----------------------------------
  "pcr_struggle_pct": {
    "type": "panel",
    "size": [ 112, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -8 ],
    "layer": 40,
    "property_bag": { "#pcr_bus": "" },
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_bus - '§0§r§2§r') = #pcr_bus))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "pcr_pct_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_pct_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "text": "#pcr_bus",
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2
        }
      }
    ]
  },

  // ---- four direction arrows (above the percentage) ----------------------
