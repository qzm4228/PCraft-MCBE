{
  "namespace": "hud",

  // PCraftRevorn vore HUD, modelled on
  //   * VCM's VoreMinigameOverlay (one coloured arrow + numbers), and
  //   * poggy's 高亮信息显示 (ui/hud_screen.json): the readout is carried by the
  //     action bar and this file replaces `hud_actionbar_text`, which the engine
  //     re-creates for every action-bar message with `$actionbar_text` set.
  //
  // No /title is used at all, so nothing can leak into the middle of the screen.
  // Bus: "§0__pcr:" + 4 markers + "§0<NN>%"; the panel hides itself unless the
  // token is present, so other action-bar messages are not swallowed by it.
  "hud_actionbar_text": {
    "type": "panel",
    "size": [ 150, 26 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 46 ],
    "layer": 40,
    "$atext": "$actionbar_text",
    "visible": "(not (($atext - '__pcr:') = $atext))",
    "controls": [
      {
        "pcr_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_arrow": {
          "type": "panel",
          "size": [ 22, 22 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 5, 0 ],
          "layer": 2,
          "controls": [
          {
            "arrow_up": {
              "type": "image",
              "size": [ "100%", "100%" ],
              "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_up",
              "$atext": "$actionbar_text",
              "visible": "(not (($atext - '§2§r§1§r') = $atext))"
            }
          },
          {
            "arrow_down": {
              "type": "image",
              "size": [ "100%", "100%" ],
              "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_down",
              "$atext": "$actionbar_text",
              "visible": "(not (($atext - '§2§r§5§r') = $atext))"
            }
          },
          {
            "arrow_left": {
              "type": "image",
              "size": [ "100%", "100%" ],
              "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_left",
              "$atext": "$actionbar_text",
              "visible": "(not (($atext - '§2§r§9§r') = $atext))"
            }
          },
          {
            "arrow_right": {
              "type": "image",
              "size": [ "100%", "100%" ],
              "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_right",
              "$atext": "$actionbar_text",
              "visible": "(not (($atext - '§2§r§d§r') = $atext))"
            }
          }
          ]
        }
      },
      {
        "pcr_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 32, 0 ],
          "layer": 2,
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "localize": false,
          "$atext": "$actionbar_text",
          "text": "('挣脱 ' + (($atext - '§0__pcr:') - '§0'))"
        }
      }
    ]
  }
}
