{
  "namespace": "hud",

  // PCraftRevorn vore HUD (JSON-UI), modelled on VCM's VoreMinigameOverlay:
  // a single 48x48 arrow in the middle of the screen (up red / right cyan /
  // down magenta / left green) plus the escape numbers in the corner.
  //
  // Patched the VCraft way: one `insert_after root_panel` inside `hud_content`,
  // no vanilla control redefinitions.
  //
  // Data bus (title string, the only HUD text Bedrock exposes globally):
  //   "§0§r§2§r"            gate marker (shows the HUD, hides the centre title)
  //   + 4 x "§2§r§<hex>§r"  direction/state (dir*4+state, constants.js hudMarker);
  //                         only the required direction carries "idle"
  //   + "§7挣脱 §fNN% …"    readable percentage (+ remaining seconds while a
  //                         prompt is open)
  "hud_content": {
    "modifications": [
      {
        "operation": "insert_after",
        "control_name": "root_panel",
        "value": [
          { "pcr_struggle_arrow@hud.pcr_struggle_arrow": {} },
          { "pcr_struggle_pct@hud.pcr_struggle_pct": {} }
        ]
      }
    ]
  },

  // the bus is written into the title; drop its visible frame so nothing big is
  // printed in the middle (modification only, never a redefinition)
  "hud_title_text": {
    "modifications": [
      { "operation": "remove", "control_name": "title_frame" }
    ]
  },

  // ---- the arrow (screen centre, like the mod) ----------------------------
  "pcr_struggle_arrow": {
    "type": "panel",
    "size": [ 48, 48 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 40,
    "controls": [
        {
          "arrow_up": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_up",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§1§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_right": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_right",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§d§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_down": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_down",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§5§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        },
        {
          "arrow_left": {
            "type": "image",
            "size": [ 48, 48 ],
            "anchor_from": "center",
            "anchor_to": "center",
            "offset": [ -3, -7 ],
            "texture": "textures/ui/pcraftrevorn/hud/vcm_arrow_left",
            "property_bag": { "#pcr_bus": "" },
            "bindings": [
              { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#pcr_bus - '§2§r§9§r') = #pcr_bus))",
                "target_property_name": "#visible"
              }
            ]
          }
        }
    ]
  },

  // ---- escape percentage (bottom-right) ----------------------------------
  "pcr_struggle_pct": {
    "type": "panel",
    "size": [ 140, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -8 ],
    "layer": 40,
    "property_bag": { "#pcr_bus": "" },
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_bus" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_bus - '§0§r§2§r') = #pcr_bus))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "pcr_pct_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_pct_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "text": "#pcr_bus",
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2
        }
      }
    ]
  }
}
