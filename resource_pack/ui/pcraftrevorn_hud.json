{
  "namespace": "hud",
  "pcraftrevorn_vore_overlay": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "clips_children": false,
    "$title_text|default": "",
    "visible": "('%.6s' * $title_text = '__pcr:')",
    "controls": [
      {
        "pcr_timer": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            -84
          ],
          "color": [
            1,
            1,
            1,
            1
          ],
          "shadow": false,
          "localize": false,
          "$pcr_timer_text|default": "",
          "$pcr_timer_visible|default": false,
          "text": "$pcr_timer_text",
          "visible": "$pcr_timer_visible",
          "variables": [
            {
              "$pcr_timer_text": "('剩余 ' + ('%.3s' * ($title_text - ('%.6s' * $title_text))) + 's')",
              "$pcr_timer_visible": "((('%.3s' * ($title_text - ('%.6s' * $title_text))) - '  0') = ('%.3s' * ($title_text - ('%.6s' * $title_text))))"
            }
          ]
        }
      },
      {
        "pcr_arrow": {
          "type": "panel",
          "size": [
            48,
            48
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            0
          ],
          "controls": [
            {
              "up_idle": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_up_idle",
                "visible": "(not (($title_text - '§2§r§1§r') = $title_text))"
              }
            },
            {
              "up_correct": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_up_correct",
                "visible": "(not (($title_text - '§2§r§2§r') = $title_text))"
              }
            },
            {
              "up_incorrect": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_up_incorrect",
                "visible": "(not (($title_text - '§2§r§3§r') = $title_text))"
              }
            },
            {
              "down_idle": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_down_idle",
                "visible": "(not (($title_text - '§2§r§5§r') = $title_text))"
              }
            },
            {
              "down_correct": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_down_correct",
                "visible": "(not (($title_text - '§2§r§6§r') = $title_text))"
              }
            },
            {
              "down_incorrect": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_down_incorrect",
                "visible": "(not (($title_text - '§2§r§7§r') = $title_text))"
              }
            },
            {
              "left_idle": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_left_idle",
                "visible": "(not (($title_text - '§2§r§9§r') = $title_text))"
              }
            },
            {
              "left_correct": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_left_correct",
                "visible": "(not (($title_text - '§2§r§a§r') = $title_text))"
              }
            },
            {
              "left_incorrect": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_left_incorrect",
                "visible": "(not (($title_text - '§2§r§b§r') = $title_text))"
              }
            },
            {
              "right_idle": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_right_idle",
                "visible": "(not (($title_text - '§2§r§d§r') = $title_text))"
              }
            },
            {
              "right_correct": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_right_correct",
                "visible": "(not (($title_text - '§2§r§e§r') = $title_text))"
              }
            },
            {
              "right_incorrect": {
                "type": "image",
                "size": [
                  "100%",
                  "100%"
                ],
                "texture": "textures/ui/pcraftrevorn/hud/struggle_right_incorrect",
                "visible": "(not (($title_text - '§2§r§f§r') = $title_text))"
              }
            }
          ]
        }
      },
      {
        "pcr_score": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            66
          ],
          "color": [
            1,
            1,
            1,
            1
          ],
          "shadow": false,
          "localize": false,
          "$pcr_score_text|default": "",
          "text": "$pcr_score_text",
          "variables": [
            {
              "$pcr_score_text": "('挣脱 ' + ('%.3s' * ($title_text - ('%.9s' * $title_text))) + '/' + ('%.3s' * ($title_text - ('%.12s' * $title_text))))"
            }
          ]
        }
      }
    ]
  }
}
