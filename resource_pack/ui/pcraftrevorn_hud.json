{
  "namespace": "hud",

  // PCraftRevorn vore HUD.
  //
  // Struggle progress: the script writes "§0§r§2§r§7挣脱 §fNN%" into the *title*
  // (the only HUD string Bedrock exposes globally as `#hud_title_text_string`).
  // The title control is redefined below so a marked title is hidden in the
  // centre, and `pcr_struggle_pct` renders the same string in the bottom-right.
  // Titles without the marker (our own 被吞入 banner, other packs) still work.
  "root_panel": {
    "modifications": [
      {
        "operation": "insert_back",
        "value": [ { "pcr_struggle_pct@hud.pcr_struggle_pct": {} } ]
      }
    ]
  },

  "hud_title_text": {
    "type": "label",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, -19 ],
    "layer": 1,
    "alpha": "@hud.anim_title_text_alpha_in",
    "color": "$title_command_text_color",
    "font_size": "extra_large",
    "localize": false,
    "property_bag": { "#pcr_title_raw": "" },
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_title_raw" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_title_raw - '§0§r§2§r') = #pcr_title_raw))",
        "target_property_name": "#visible"
      }
    ],
    "text": "#pcr_title_raw"
  },

  // bottom-right percentage: hidden unless the title carries our marker
  "pcr_struggle_pct": {
    "type": "panel",
    "size": [ 112, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -8 ],
    "layer": 40,
    "property_bag": { "#pcr_pct_text": "" },
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_pct_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_pct_text - '§0§r§2§r') = #pcr_pct_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "pcr_pct_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_pct_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "text": "#pcr_pct_text",
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2
        }
      }
    ]
  },

  // ---- legacy boss-bar HUD (kept for reference, patch disabled) ----
  //
  // NOTE: the graphical HUD is currently DISABLED on purpose.
  //
  // hud.boss_health_panel is the *grid_item_template* of hud.boss_health_grid,
  // i.e. the engine clones it once per boss bar. Attaching `modifications` to a
  // template makes the clone lose its type ("Type not specified ... for control:
  // boss_health_panel") and the client crashes with 0xc0000005 the moment a bar
  // appears (1.21.100, crash offset 0x3c9a47). Until the overlay can be hung on a
  // non-template control and tested in game, the struggle prompt stays on the
  // action bar + the four locked hotbar items.
  //
  // "boss_health_panel": {
  //   "modifications": [
  //     {
  //       "operation": "insert_back",
  //       "value": [
  //         { "pcr_boss_hud_instance@hud.pcr_boss_hud": {} }
  //       ]
  //     }
  //   ]
  // },

  "pcr_boss_hud": {
    "type": "panel",
    "size": [ 320, 32 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 0 ],
    "property_bag": { "#pcr_boss_name": "" },
    "bindings": [
      {
        "binding_name": "#bossName",
        "binding_name_override": "#pcr_boss_name",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_boss_name - '§0§r§1§r') = #pcr_boss_name))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        // covers the vanilla boss bar: our frame is not fully opaque, so without
        // this the vanilla bar would peek through it
        "pcr_plate": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ 182, 12 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 9 ],
          "layer": 1
        }
      },
      {
        "pcr_frame": {
          "type": "image",
          "texture": "textures/ui/pcraftrevorn/hud/acid_indicator",
          "size": [ 320, 32 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 2
        }
      },
      {
        "pcr_fill": {
          "type": "image",
          "texture": "textures/ui/pcraftrevorn/hud/acid_bar_fill",
          "size": [ 300, 8 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 1, 12 ],
          "layer": 3,
          "clip_direction": "left",
          "bindings": [
            {
              "binding_name": "#progress_percentage",
              "binding_name_override": "#clip_ratio",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            }
          ]
        }
      },
      {
        // The original draws all four arrows in one 48x48 box: each sprite keeps
        // its arrow against its own edge, so the four read as a cross.
        "pcr_arrows": {
          "type": "panel",
          "size": [ 48, 48 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 34 ],
          "layer": 4,
          "controls": [
            { "pcr_up_off@hud.pcr_arrow_up_off": {} },
            { "pcr_up_idle@hud.pcr_arrow_up_idle": {} },
            { "pcr_up_correct@hud.pcr_arrow_up_correct": {} },
            { "pcr_up_incorrect@hud.pcr_arrow_up_incorrect": {} },
            { "pcr_down_off@hud.pcr_arrow_down_off": {} },
            { "pcr_down_idle@hud.pcr_arrow_down_idle": {} },
            { "pcr_down_correct@hud.pcr_arrow_down_correct": {} },
            { "pcr_down_incorrect@hud.pcr_arrow_down_incorrect": {} },
            { "pcr_left_off@hud.pcr_arrow_left_off": {} },
            { "pcr_left_idle@hud.pcr_arrow_left_idle": {} },
            { "pcr_left_correct@hud.pcr_arrow_left_correct": {} },
            { "pcr_left_incorrect@hud.pcr_arrow_left_incorrect": {} },
            { "pcr_right_off@hud.pcr_arrow_right_off": {} },
            { "pcr_right_idle@hud.pcr_arrow_right_idle": {} },
            { "pcr_right_correct@hud.pcr_arrow_right_correct": {} },
            { "pcr_right_incorrect@hud.pcr_arrow_right_incorrect": {} }
          ]
        }
      }
    ]
  },

  // --- direction sprites -----------------------------------------------------
  // One marker per direction/state: PROGRESS_MARKER + progressCode(dir*4 + state)
  //   up    off/idle/correct/incorrect = 0 1 2 3
  //   down                             = 4 5 6 7
  //   left                             = 8 9 a b
  //   right                            = c d e f
  "pcr_arrow_up_off": {
    "type": "image",
    "size": [ 48, 48 ],
    "texture": "textures/ui/pcraftrevorn/hud/struggle_up_off",
    "property_bag": { "#pcr_arrow_name": "" },
    "bindings": [
      { "binding_name": "#bossName", "binding_name_override": "#pcr_arrow_name", "binding_type": "collection", "binding_collection_name": "boss_bars" },
      { "binding_type": "view", "source_property_name": "(not ((#pcr_arrow_name - '§2§r§0§r') = #pcr_arrow_name))", "target_property_name": "#visible" }
    ]
  },
