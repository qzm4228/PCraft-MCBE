{
  "namespace": "hud",

  // PCraftRevorn vore HUD (JSON-UI).
  //
  // Patched exactly like the VCraft pack's ui/hud_screen.json: a single
  // `insert_after root_panel` inside `hud_content`. Vanilla controls are never
  // redefined -- replacing hud_title_text in the previous build broke the whole
  // HUD.
  //
  // Struggle progress: the script writes "§0§r§2§r§7挣脱 §fNN%" into the *title*
  // (the only HUD string Bedrock exposes globally, `#hud_title_text_string`).
  // `pcr_struggle_pct` renders it in the bottom-right corner. The title frame is
  // removed with a modification so the same text is not printed big in the
  // middle; if that op is ever ignored the text merely shows twice.
  "hud_content": {
    "modifications": [
      {
        "operation": "insert_after",
        "control_name": "root_panel",
        "value": [
          { "pcr_struggle_pct@hud.pcr_struggle_pct": {} }
        ]
      }
    ]
  },

  "hud_title_text": {
    "modifications": [
      { "operation": "remove", "control_name": "title_frame" }
    ]
  },

  "pcr_struggle_pct": {
    "type": "panel",
    "size": [ 112, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -8 ],
    "layer": 40,
    "property_bag": { "#pcr_pct_text": "" },
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_name_override": "#pcr_pct_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#pcr_pct_text - '§0§r§2§r') = #pcr_pct_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "pcr_pct_bg": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", "100%" ],
          "alpha": 0.35,
          "layer": 1
        }
      },
      {
        "pcr_pct_label": {
          "type": "label",
          "size": [ "100%", "100%" ],
          "text": "#pcr_pct_text",
          "font_size": "large",
          "color": [ 1, 1, 1, 1 ],
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2
        }
      }
    ]
  }
}
