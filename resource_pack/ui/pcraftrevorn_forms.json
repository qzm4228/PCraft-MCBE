{
  "namespace": "server_form",
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "$additional_screen_content": "server_form.pcraftrevorn_additional_content",
    // Non-blocking overlay screen: the non-modal subset of vanilla 1.21.100.6
    // `debug_screen` (the one vanilla screen that pops up over gameplay with a
    // working button while the game below keeps receiving input).
    //
    // IMPORTANT: these flags MUST be literal booleans. Writing a Molang
    // expression here is not supported by the engine: a non-empty string is
    // truthy, so `absorbs_input` becomes true and the screen swallows every
    // touch -- the joystick and camera die. That was the bug that made the
    // HUD bar "knock out" the touch controls no matter how the buttons were
    // laid out.
    "send_telemetry": false,
    "is_showing_menu": false,
    "absorbs_input": false,
    "render_only_when_topmost": false,
    "render_game_behind": true,
    "always_accepts_input": true,
    // Deliberately NOT `screen_not_flushable` / `screen_draws_last`: those are
    // overlay-only flags (debug_screen uses them because it must never be
    // closed). On a form screen they stop the previous form from being flushed
    // and put it back on top, so opening the options form from the guide left
    // both screens stacked and unclickable.
    "low_frequency_rendering": true,
    // Vanilla screens draw a centered loading bar while the screen opens
    // (`common.base_screen` -> loading_bars_background, gated on
    // `$use_loading_bars`). Our form is persistent, so that bar just flickers
    // in the middle of the screen. debug_screen turns it off the same way.
    "$use_loading_bars": false,
    "$screen_animations": [],
    "$background_animations": [],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },
  "pcraftrevorn_additional_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "layer@server_form.pcraftrevorn_layer": {}
      }
    ]
  },
  "pcraftrevorn_layer": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§0§r§1§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bar@server_form.pcraftrevorn_progress_bar": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            -14
          ]
        }
      }
    ]
  },
