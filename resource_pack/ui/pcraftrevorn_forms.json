{
  "namespace": "server_form",
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    // The HUD bar is disabled for now, so this screen can be a normal modal
    // menu: the game pauses and the engine gives us the mouse pointer, which is
    // what the JSON-UI menus need. The non-modal variant is kept in git history
    // for when the HUD comes back on a different host.
    //
    // IMPORTANT: these flags MUST be literal booleans. Writing a Molang
    // expression here is not supported by the engine: a non-empty string is
    // truthy, so `absorbs_input` becomes true and the screen swallows every
    // touch.
    "send_telemetry": false,
    "is_showing_menu": true,
    "absorbs_input": true,
    "render_only_when_topmost": true,
    "render_game_behind": true,
    // Do not capture/hide the OS cursor.
    "should_steal_mouse": false,
    "low_frequency_rendering": true,
    // Vanilla screens draw a centered loading bar while the screen opens; a
    // form is transient, so turn it off like debug_screen does.
    "$use_loading_bars": false,
    "$screen_animations": [],
    "$background_animations": [],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  }
}
