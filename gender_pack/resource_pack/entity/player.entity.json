            "render_controllers": [
                { "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator" },
                { "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator" },
                { "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator" },
                { "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" },
                { "controller.render.player.map": "variable.map_face_icon" },
                { "controller.render.b": "!variable.is_first_person && math.mod(query.scoreboard('pc_state'), 10) > 0" },
                { "controller.render.pcskin1": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && math.floor(query.scoreboard('pc_state') / 10) == 1" },
                { "controller.render.pcskin2": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && math.floor(query.scoreboard('pc_state') / 10) == 2" },
                { "controller.render.pcskin3": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && math.floor(query.scoreboard('pc_state') / 10) == 3" },
