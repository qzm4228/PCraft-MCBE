{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "minecraft:player",
            "materials": {
                "default": "entity_alphatest",
                "cape": "entity_alphatest",
                "animated": "player_animated",
                "spectator": "player_spectator"
            },
            "textures": {
                "default": "textures/entity/steve",
                "cape": "textures/entity/cape_invisible",
                "preset1": "textures/pcraftrevorn_gender/presets/preset1",
                "preset2": "textures/pcraftrevorn_gender/presets/preset2",
                "preset3": "textures/pcraftrevorn_gender/presets/preset3",
                "preset4": "textures/pcraftrevorn_gender/presets/preset4",
                "preset5": "textures/pcraftrevorn_gender/presets/preset5",
                "preset6": "textures/pcraftrevorn_gender/presets/preset6",
                "preset7": "textures/pcraftrevorn_gender/presets/preset7",
                "preset8": "textures/pcraftrevorn_gender/presets/preset8",
                "preset9": "textures/pcraftrevorn_gender/presets/preset9",
                "preset10": "textures/pcraftrevorn_gender/presets/preset10",
                "preset11": "textures/pcraftrevorn_gender/presets/preset11",
                "preset12": "textures/pcraftrevorn_gender/presets/preset12",
                "vcraft_belly": "textures/vcraft/belly"
            },
            "geometry": {
                "default": "geometry.humanoid.custom",
                "b": "geometry.b",
                "chest": "geometry.pcraftrevorn_chest",
                "vcraft_belly": "geometry.vcraft_belly",
                "cape": "geometry.cape"
            },
            "scripts": {
                "scale": "0.9375",
                "variables": {
                    "variable.fp_melee_spear_use_attachable_rotation_z": "public",
                    "variable.tp_melee_spear_use_attachable_rotation_z": "public",
                    "variable.fp_melee_spear_attack_attachable_rotation_z": "public",
                    "variable.tp_melee_spear_attack_attachable_position_z": "public",
                    "variable.attack_time": "public",
                    "variable.item_use_normalized": "public"
                },
                "initialize": [
                    "v.is_holding_right = 0.0;",
                    "v.is_blinking = 0.0;",
                    "v.last_blink_time = 0.0;",
                    "v.hand_bob = 0.0;"
                ],
                "pre_animation": [
                    // Layers
                    "v.helmet_layer_visible = !query.has_head_gear;",
                    "v.leg_layer_visible = 1.0;",
                    "v.boot_layer_visible = 1.0;",
                    "v.chest_layer_visible = 1.0;",
                    // Body
                    "v.attack_body_rot_y = Math.sin(360 * Math.sqrt(v.attack_time)) * 10.0;",
                    "v.tcos0 = math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / v.gliding_speed_value * 57.3;",
                    "v.first_person_item_rotation_factor = math.sin((1 - v.attack_time) * 180.0);",
                    "v.hand_bob = query.life_time < 0.01 ? 0.0 : v.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - v.hand_bob) * 0.02;",
                    // Items
                    "v.map_angle = math.clamp(1 - v.player_x_rotation / 45.1, 0.0, 1.0);",
                    "v.item_use_duration = query.main_hand_item_use_duration > 0.0 ? (query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) : 0.0;",
                    "v.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
                    // Riding
                    "v.riding_y_offset = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat', 'minecraft:strider') ? -3.0 : 0.0;",
                    // (1.26 "melee spear" Molang removed: math.inverse_lerp / math.ease_* /
                    //  query.kinetic_weapon_* / query.base_swing_duration are not available
                    //  on older engine versions and spam content-log errors.)
                    "variable.RJ = !query.is_sleeping && !variable.is_first_person && query.is_sprinting && !query.is_swimming && !query.is_riding && !query.is_gliding && !query.is_on_ground;",
                    
                    "variable.fighting = variable.attack_time > 0 && variable.attack_time < 0.5;",
                    
                    "variable.bow = query.is_using_item && query.get_equipped_item_name == 'bow';",
                    
                    "variable.fishing_rod = query.get_equipped_item_name == 'fishing_rod';",
                    
                    "variable.fishing = query.get_equipped_item_name == 'fishing_rod' && query.is_using_item;",
                    
                    "variable.bf = variable.fishing_rod || variable.bow;"
                    
                ],
                "animate": [
                    "root",
          "bow_chargingc",
          "fishing_rod_usec",
          "fishing_rodc",
          "glidingc",
          "swimmingc",
          "controller_rj",
          "controller_walking",
          "walking_legsc",
          "controller_running",
          "punchingc",
          "attackc",
          "jumpc",
          "sneakingc",
          "stopc",
          "fallc",
          "turnrc",
          "hidec"
                ],
                "should_update_effects_offscreen": "1.0"
            },
            "animations": {
        "no": "animation.player.no",
        "fishing_rod_usec": "controller.animation.player.fishing_rod_use",
        "fishing_rod_use": "animation.player.fishing_rod_use",
        "fishing_rodc": "controller.animation.player.fishing_rod",
        "fishing_rod_hold": "animation.player.fishing_rod_hold",
        "glidingc": "controller.animation.player.gliding",
        "gliding": "animation.player.gliding",
        "swimmingc": "controller.animation.player.swimming",
        "swim": "animation.player.swimming",
        "swim_spear": "animation.player.swimming_spear",
        "bow_chargingc": "controller.animation.player.bow_charging",
        "bow_charging": "animation.player.bow_charging",
        "punchingc": "controller.animation.player.punching",
        "punching": "animation.player.punch",
        "controller_rj": "controller.animation.RJ",
        "rjra": "animation.player.rjra",
        "rjla": "animation.player.rjla",
        "sneakingc": "controller.animation.sneaking",
        "sneak": "animation.player.sneakin",
        "controller_walking": "controller.animation.player.walking",
        "walking": "animation.player.walking",
        "walking_legsc": "controller.animation.player.walking_legs",
        "walking_legs": "animation.player.walking_legs",
        "controller_running": "controller.animation.player.running",
        "running": "animation.player.running",
        "attackc": "controller.animation.player.attacking",
        "attack": "animation.player.attacking",
        "hidec": "controller.animation.player.hide",
        "hide": "animation.player.hide",
        "turnrc": "controller.animation.player.turnr",
        "turnr": "animation.player.turnr",
        "fallc": "controller.animation.player.fall",
        "fall": "animation.player.fall",
        "stopc": "controller.animation.player.stop",
        "unsneak": "animation.player.unsneak",
        "jumpc": "controller.animation.player.jump",
        "jump": "animation.player.jump",
        "attackc": "controller.animation.player.attacking",
        "attack": "animation.player.attacking",
        "stopping": "animation.player.stopj",
        "running_spear": "animation.player.running_spear",
        "running_legs": "animation.player.running_legs",
                "root": "controller.animation.player.root",
                "base_controller": "controller.animation.player.base",
                "hudplayer": "controller.animation.player.hudplayer",
                "humanoid_base_pose": "animation.humanoid.base_pose",
                "look_at_target": "controller.animation.humanoid.look_at_target",
                "look_at_target_ui": "animation.player.look_at_target.ui",
                "look_at_target_default": "animation.humanoid.look_at_target.default",
                "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
                "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
                "look_at_target_inverted": "animation.player.look_at_target.inverted",
                "cape": "animation.player.cape",
                "move.arms": "animation.player.no",
                "move.legs": "animation.player.no",
                "swimming": "animation.player.no",
                "swimming.no_right_arm": "animation.player.no",
                "swimming.legs": "animation.player.swim.legs",
                "crawling": "animation.player.crawl",
                "crawling.no_right_arm": "animation.player.crawl.no_right_arm",
                "crawling.legs": "animation.player.crawl.legs",
                "riding.root": "animation.player.riding.root",
                "riding.arms": "animation.player.riding.arms",
                "riding.legs": "animation.player.riding.legs",
                "holding": "animation.player.hold_thing",
                "holding_heavy_core": "animation.player.holding_heavy_core",
                "brandish_spear": "animation.humanoid.brandish_spear",
                "holding_spyglass": "animation.humanoid.holding_spyglass",
                "charging": "animation.humanoid.charging",
                "attack.positions": "animation.player.attack.positions",
                "attack.rotations": "animation.player.punch_rotation",
                "sneaking": "animation.player.no",
                "bob": "animation.player.idle",
                "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
                "bow_and_arrow": "animation.humanoid.bow_and_arrow",
                "use_item_progress": "animation.player.uip",
                "skeleton_attack": "animation.skeleton.attack",
                "sleeping": "animation.player.sleeping",
                "first_person_base_pose": "animation.player.first_person.base_pose",
                "first_person_empty_hand": "animation.player.first_person.empty_hand",
                "first_person_swap_item": "animation.player.first_person.swap_item",
                "first_person_shield_block": "animation.player.first_person.shield_block",
                "first_person_attack_controller": "controller.animation.player.first_person_attack",
                "first_person_attack_rotation": "animation.player.first_person.attack_rotation",
                "first_person_vr_attack_rotation": "animation.player.first_person.vr_attack_rotation",
                "first_person_walk": "animation.player.first_person.walk",
                "first_person_map_controller": "controller.animation.player.first_person_map",
                "first_person_map_hold": "animation.player.first_person.map_hold",
                "first_person_map_hold_attack": "animation.player.first_person.map_hold_attack",
                "first_person_map_hold_off_hand": "animation.player.first_person.map_hold_off_hand",
                "first_person_map_hold_main_hand": "animation.player.first_person.map_hold_main_hand",
                "first_person_crossbow_equipped": "animation.player.first_person.crossbow_equipped",
                "third_person_crossbow_equipped": "animation.player.crossbow_equipped",
                "third_person_bow_equipped": "animation.player.be",
                "first_person_melee_spear_use": "animation.player.first_person.melee_spear_use",
                "first_person_melee_spear_hold": "animation.player.first_person.melee_spear_hold",
                "first_person_melee_spear_attack": "animation.player.first_person.melee_spear_attack",
                "first_person_melee_spear_controller": "controller.animation.player.first_person_melee_spear",
                "third_person_melee_spear_use": "animation.humanoid.melee_spear_use",
                "third_person_melee_spear_hold": "animation.humanoid.melee_spear_hold",
                "third_person_melee_spear_attack": "animation.player.melee_spear_attack",
                "third_person_melee_spear_controller": "controller.animation.player.melee_spear",
                "crossbow_hold": "animation.player.crossbow_hold",
                "crossbow_controller": "controller.animation.player.crossbow",
                "shield_block_main_hand": "animation.player.shield_block_main_hand",
                "shield_block_off_hand": "animation.player.shield_off_blocking",
                "blink": "controller.animation.persona.blink",
                "tooting_goat_horn": "animation.humanoid.tooting_goat_horn",
                "holding_brush": "animation.humanoid.holding_brush",
                "brushing": "animation.humanoid.brushing"
            },
            "render_controllers": [
                { "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator" },
                { "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator" },
                { "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator" },
                { "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" },
                { "controller.render.player.map": "variable.map_face_icon" },
                { "controller.render.pcraftrevorn.chest": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" },
                { "controller.render.vcraft_belly1": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" },
                { "controller.render.vcraft_belly2": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" }
            ],
            "enable_attachables": true
        }
    }
}
