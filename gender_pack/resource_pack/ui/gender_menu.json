{
  "namespace": "server_form",

  // ---------------------------------------------------------------------------
  // One file owns the whole server_form look:
  //   * the vanilla form (every other addon / our own guide & settings forms)
  //   * the Female Gender Mod wardrobe panel (title starts with "§3§r")
  //   * the PCraft HUD button bar (title is exactly "PCraft HUD")
  // The three never overlap because each one is gated on its own title marker,
  // so the HUD form and the gender panel can share the same definitions without
  // fighting over `long_form`.
  // ---------------------------------------------------------------------------

  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      },
      { "gender_root@server_form.gender_root": {} }
    ]
  },

  // The factory instantiates this panel; everything inside is centered/anchored
  // by us because the wrapper itself is full screen.
  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        // Touch variant only: the screen is non-modal there, so empty-space taps
        // must be swallowed by our menu instead of reaching the world. Hidden for
        // the wardrobe (its own shield) and for native forms.
        "menu_shield": {
          "type": "input_panel",
          "size": [ "100%", "100%" ],
          "prevent_touch_input": true,
          "layer": 1,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§r§1§r') = #title_text)) and ((#title_text - '§3§r') = #title_text) and ((#title_text - 'PCraft HUD') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 15px", 10 ],
          "$title_max_size": [ "100% - 15px", 10 ],
          "size": [ 225, 200 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - '§0§r§1§r') = #title_text) and ((#title_text - '§3§r') = #title_text) and ((#title_text - 'PCraft HUD') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      { "hud_buttons@server_form.hud_buttons": {} },
      { "menu@server_form.pcr_menu_root": {} }
    ]
  },

  // ---- HUD button bar (FemaleGenderMod entry) -------------------------------

  "hud_buttons": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 90, 120 ],
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'PCraft HUD') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "gender@server_form.hud_gender_slot": {
          "offset": [ -30, 44 ]
        }
      },
      {
        "vore@server_form.hud_vore_slot": {
          "offset": [ -30, 72 ]
        }
      }
    ]
  },

  // 22x22 drawn buttons (gender / vore), right-aligned with a margin. The
  // textures are hard-coded per button -- no $variables, no form-level icon.
  "hud_gender_slot": {
    "type": "collection_panel",
    "collection_name": "form_buttons",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 22, 22 ],
    "controls": [
      {
        "btn@server_form.hud_gender_button": {
          "collection_index": 0
        }
      }
    ]
  },

  "hud_vore_slot": {
    "type": "collection_panel",
    "collection_name": "form_buttons",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 22, 22 ],
    "controls": [
      {
        "btn@server_form.hud_vore_button": {
          "collection_index": 1
        }
      }
    ]
  },

  "hud_gender_button@common.button": {
    "size": [ "100%", "100%" ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "art": {
          "type": "image",
          "texture": "textures/pcraftrevorn_gender/gui/hud_gender",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },

  "hud_vore_button@common.button": {
    "size": [ "100%", "100%" ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "art": {
          "type": "image",
          "texture": "textures/pcraftrevorn_gender/gui/hud_vore",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },

  // ---- JSON-UI form shell (every PCraft / VCraft form) ----------------------
  //
  // Every script form carries the invisible PCraft marker (§0§r§1§r) in its
  // title. The native form is hidden for those titles and this panel draws the
  // whole thing instead: title, body, and the form_buttons collection (so
  // `button.form_button_click` still resolves the show() promise).
  // The wardrobe (§3§r) and the HUD bar ("PCraft HUD") keep their own panels.
  "pcr_menu_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 6,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§0§r§1§r') = #title_text)) and ((#title_text - '§3§r') = #title_text) and ((#title_text - 'PCraft HUD') = #title_text)",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "dim": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "textures/ui/Black",
          "alpha": 0.55
        }
      },
      {
        "panel": {
          "type": "panel",
          "size": [ 300, 340 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "bg": {
                "type": "image",
                "size": [ "100%", "100%" ],
                "texture": "textures/ui/Black",
                "alpha": 0.92
              }
            },
            {
              "content": {
                "type": "stack_panel",
                "orientation": "vertical",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [ 0, 10 ],
                "size": [ 276, "100%c" ],
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "size": [ "100%", "default" ],
                      "text": "#title_text",
                      "color": [ 1, 1, 1, 1 ],
                      "shadow": true,
                      "localize": false,
                      "font_size": "large",
                      "text_alignment": "center"
                    }
                  },
                  {
                    "gap_title": {
                      "type": "panel",
                      "size": [ 0, 6 ]
                    }
                  },
                  {
                    "body": {
                      "type": "label",
                      "size": [ "100%", "default" ],
                      "text": "#body_text",
                      "color": [ 0.78, 0.78, 0.84, 1 ],
                      "shadow": true,
                      "localize": false,
                      "font_size": "small",
                      "text_alignment": "center"
                    }
                  },
                  {
                    "gap_body": {
                      "type": "panel",
                      "size": [ 0, 8 ]
                    }
                  },
                  {
                    "buttons@server_form.pcr_menu_buttons": {
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "pcr_menu_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 276, "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.pcr_menu_button",
        "label": "server_form.pcr_menu_label",
        "header": "server_form.pcr_menu_header"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "pcr_menu_button": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 276, "100%c" ],
    "controls": [
      {
        "btn@common_buttons.light_text_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 276, 22 ],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 20 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "spacer": {
          "type": "panel",
          "size": [ 0, 2 ]
        }
      }
    ]
  },

  "pcr_menu_label": {
    "type": "label",
    "size": [ 276, "default" ],
    "text": "#form_button_text",
    "color": [ 0.78, 0.78, 0.84, 1 ],
    "shadow": true,
    "localize": false,
    "font_size": "normal",
    "text_alignment": "center",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ]
  },

  "pcr_menu_header": {
    "type": "label",
    "size": [ 276, "default" ],
    "text": "#form_button_text",
    "color": [ 1, 1, 1, 1 ],
    "shadow": true,
    "localize": false,
    "font_size": "large",
    "text_alignment": "center",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ]
  },

  // ---- Female Gender Mod wardrobe panel -------------------------------------

  "gender_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 5,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§3§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "shield": {
          "type": "input_panel",
          "size": [ "100%", "100%" ],
          "prevent_touch_input": true,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§3§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "dim": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "textures/ui/Black",
          "alpha": 0.55
        }
      },
      {
        "panel@server_form.gender_panel": {
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "gender_panel": {
    "type": "panel",
    "size": [ 248, 156 ],
    "controls": [
      {
        "bg_female": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_female",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§3§r1') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bg_male": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_male",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§3§r1') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 10, 8 ],
          "size": [ "default", "default" ],
          "color": [ 0.85, 0.85, 0.9 ],
          "text": "Female Gender Mod",
          "shadow": true
        }
      },
      {
        "player_preview": {
          "type": "panel",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 10, 0 ],
          "size": [ 58, 99 ],
          "controls": [
            {
              "player_renderer": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "property_bag": { "#look_at_cursor": true },
                "layer": 8,
                "anchor_from": "center",
                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "buttons@server_form.gender_buttons_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 86, 22 ]
        }
      }
    ]
  },

  "gender_buttons_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 158, "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.gender_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "gender_dynamic_button": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 158, "100%c" ],
    "controls": [
      {
        "btn@common_buttons.light_text_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 158, 20 ],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 18 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "spacer": {
          "type": "panel",
          "size": [ 0, 2 ]
        }
      }
    ]
  },

  // Factory entries for ActionFormData.label() / .header() inside the wardrobe
  // panel (the factory maps control id "label"/"header" to these).
  "dynamic_label": {
    "type": "label",
    "size": [ 158, "default" ],
    "text": "#form_button_text",
    "color": [ 0.78, 0.78, 0.84, 1 ],
    "shadow": true,
    "localize": false,
    "font_size": "normal",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ]
  },

  "dynamic_header": {
    "type": "label",
    "size": [ 158, "default" ],
    "text": "#form_button_text",
    "color": [ 1, 1, 1, 1 ],
    "shadow": true,
    "localize": false,
    "font_size": "large",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ]
  }
}
