{
  "namespace": "server_form",

  // ---------------------------------------------------------------------------
  // One file owns the whole server_form look:
  //   * the vanilla form (every other addon / our own guide & settings forms)
  //   * the Female Gender Mod wardrobe panel (title starts with "§3§r")
  //   * the PCraft HUD button bar (title is exactly "PCraft HUD")
  // The three never overlap because each one is gated on its own title marker,
  // so the HUD form and the gender panel can share the same definitions without
  // fighting over `long_form`.
  // ---------------------------------------------------------------------------

  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      },
      { "gender_root@server_form.gender_root": {} }
    ]
  },

  // The factory instantiates this panel; everything inside is centered/anchored
  // by us because the wrapper itself is full screen.
  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 15px", 10 ],
          "$title_max_size": [ "100% - 15px", 10 ],
          "size": [ 225, 200 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - '§3§r') = #title_text) and ((#title_text - 'PCraft HUD') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      { "hud_buttons@server_form.hud_buttons": {} }
    ]
  },

  // ---- HUD button bar (FemaleGenderMod entry) -------------------------------

  "hud_buttons": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 90, 120 ],
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'PCraft HUD') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "gender@server_form.hud_gender_slot": {
          "offset": [ -30, 44 ]
        }
      },
      {
        "vore@server_form.hud_vore_slot": {
          "offset": [ -30, 72 ]
        }
      }
    ]
  },

  // 22x22 drawn buttons (gender / vore), right-aligned with a margin. The
  // textures are hard-coded per button -- no $variables, no form-level icon.
  "hud_gender_slot": {
    "type": "collection_panel",
    "collection_name": "form_buttons",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 22, 22 ],
    "controls": [
      {
        "btn@server_form.hud_gender_button": {
          "collection_index": 0
        }
      }
    ]
  },

  "hud_vore_slot": {
    "type": "collection_panel",
    "collection_name": "form_buttons",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ 22, 22 ],
    "controls": [
      {
        "btn@server_form.hud_vore_button": {
          "collection_index": 1
        }
      }
    ]
  },

  "hud_gender_button@common.button": {
    "size": [ "100%", "100%" ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "art": {
          "type": "image",
          "texture": "textures/pcraftrevorn_gender/gui/hud_gender",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },

  "hud_vore_button@common.button": {
    "size": [ "100%", "100%" ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "art": {
          "type": "image",
          "texture": "textures/pcraftrevorn_gender/gui/hud_vore",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },

  // ---- Female Gender Mod wardrobe panel -------------------------------------

  "gender_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 5,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§3§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "shield": {
          "type": "input_panel",
          "size": [ "100%", "100%" ],
          "prevent_touch_input": true,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§3§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "dim": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "textures/ui/Black",
          "alpha": 0.55
        }
      },
      {
        "panel@server_form.gender_panel": {
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "gender_panel": {
    "type": "panel",
    "size": [ 248, 156 ],
    "controls": [
      {
        "bg_female": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_female",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§3§r1') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bg_male": {
          "type": "image",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_male",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§3§r1') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 10, 8 ],
          "size": [ "default", "default" ],
          "color": [ 0.85, 0.85, 0.9 ],
          "text": "Female Gender Mod",
          "shadow": true
        }
      },
      {
        "player_preview": {
          "type": "panel",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 10, 0 ],
          "size": [ 58, 99 ],
          "controls": [
            {
              "player_renderer": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "property_bag": { "#look_at_cursor": true },
                "layer": 8,
                "anchor_from": "center",
                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "buttons@server_form.gender_buttons_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 86, 22 ]
        }
      }
    ]
  },

  "gender_buttons_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 158, "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.gender_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "gender_dynamic_button": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 158, "100%c" ],
    "controls": [
      {
        "btn@common_buttons.light_text_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 158, 20 ],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 18 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "spacer": {
          "type": "panel",
          "size": [ 0, 3 ]
        }
      }
    ]
  }
}
