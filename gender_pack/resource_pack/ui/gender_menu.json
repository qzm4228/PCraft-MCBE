{
  "namespace": "server_form",

  // Rebuild the form screen content: native form (hidden for gender forms) + our
  // WFC layer as a sibling of the form factory.
  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      },
      { "gender_root@server_form.gender_root": {} }
    ]
  },

  // Hide the native ActionForm panel while our gender menu is open
  // (title contains the §3§r marker).
  "long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [ "100% - 15px", 10 ],
    "$title_max_size": [ "100% - 15px", 10 ],
    "size": [ 225, 200 ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§3§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "gender_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 5,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§3§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "dim": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "textures/ui/Black",
          "alpha": 0.55
        }
      },
      {
        "panel_female": {
          "type": "image",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_female",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§3§r1') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "panel_male": {
          "type": "image",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ 248, 156 ],
          "texture": "textures/pcraftrevorn_gender/gui/wardrobe_male",
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§3§r1') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "player_preview": {
          "type": "custom",
          "renderer": "paper_doll_renderer",
          "layer": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ -82, 6 ],
          "size": [ 64, 96 ],
          "use_selected_skin": false,
          "use_player_paperdoll": true,
          "use_skin_gui_scale": true
        }
      },
      {
        "title": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ -118, -60 ],
          "size": [ "default", "default" ],
          "color": [ 0.27, 0.27, 0.27 ],
          "text": "Female Gender Mod",
          "shadow": false
        }
      },
      {
        "buttons@server_form.gender_buttons_panel": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 37, 12 ]
        }
      }
    ]
  },

  "gender_buttons_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%c", "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.gender_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "gender_dynamic_button": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "btn@common_buttons.light_text_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 158, 20 ],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 18 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "spacer": {
          "type": "panel",
          "size": [ 0, 3 ]
        }
      }
    ]
  }
}
