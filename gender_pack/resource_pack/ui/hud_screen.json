// Exactly MSIFvAPI's hud_screen override (v11 RP). Keeping it flag-only is what
// makes it version-safe: the engine merges these properties into the vanilla
// hud_screen, so $screen_content / button_mappings stay whatever the running
// version ships. Do NOT hard-code $screen_content here.
{
  "namespace": "hud",
  "hud_screen@common.base_screen": {
    "is_showing_menu": false,
    "should_steal_mouse": true,
    "low_frequency_rendering": true,
    "absorbs_input": false,
    "render_only_when_topmost": false,
    "send_telemetry": false,
    "$screen_animations": [],
    "$background_animations": [],
    "load_screen_immediately": true,
    "always_accepts_input": true
  }
}
