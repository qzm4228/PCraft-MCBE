{
	"format_version": "1.8.0",
	"animations": {
		"animation.player.hold_thing" : {
			"loop" : true,
			"bones" : {
				"leftarm" : {
					"rotation" : [ "!query.is_gliding && !variable.fishing_rod && variable.is_holding_left ? (-this * 0.5 - 18.0) : 0.0", 0.0, 0.0 ]
				},
				"rightarm" : {
					"rotation" : [ "!query.is_gliding && !variable.fishing_rod && variable.is_holding_right ? (-this * 0.5 - 18.0) : 0.0", 0.0, 0.0 ]
				}
			}
		}
	}
}